# Copy to .env and fill in. Generate the values with tools/get_env.js
# (paste it into the DevTools console on instagram.com).

# Instagram session (from your logged-in browser)
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=

# Optional: whose following list to fetch (defaults to IG_DS_USER_ID)
IG_TARGET_USER_ID=
